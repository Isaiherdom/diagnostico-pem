const SCALE4 = [
  "Conozco el concepto, necesito que me supervisen para hacerlo",
  "Lo hago de forma estándar, con supervisión ocasional",
  "Lo hago sin supervisión, resuelvo variaciones comunes",
  "Puedo resolver casos complejos y formar a otros en esto"
];

const app = document.getElementById("app");
const folioTag = document.getElementById("folioTag");

function newId(){ return Date.now().toString(36) + "-" + Math.random().toString(36).slice(2,8); }
function esc(s){ return String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

function withTimeout(promise, ms, label){
  return Promise.race([
    promise,
    new Promise((_, reject) => setTimeout(() => reject(new Error("TIMEOUT:"+label)), ms))
  ]);
}
function checkRequired(formEl, errEl){
  if(formEl.checkValidity()) return true;
  const invalid = formEl.querySelector(":invalid");
  if(invalid){
    invalid.scrollIntoView({ behavior:"smooth", block:"center" });
    try{ invalid.focus({ preventScroll:true }); }catch(e){}
  }
  errEl.textContent = "Falta responder una o más preguntas obligatorias. Te llevamos al primer campo pendiente — revísalo y vuelve a enviar.";
  errEl.style.display = "block";
  return false;
}
function sleep(ms){ return new Promise(r => setTimeout(r, ms)); }

// ⚠️ Reemplaza esta URL por la que te da Google Apps Script al implementar (termina en /exec)
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyNe88GIxNLl4zZFGB9sTmk62-0s9cOVM-x9nUlPbjFkdijbN_KCk1WTU_OwZgxjsiAaw/exec";

async function saveEntry(sheetName, payload){
  const id = newId();
  payload.folio = id;
  const body = JSON.stringify({ encuesta: sheetName, data: payload });
  let lastErr;
  for(let attempt=1; attempt<=4; attempt++){
    try{
      const res = await withTimeout(fetch(SCRIPT_URL, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body
      }), 12000, "guardar");
      if(!res.ok) throw new Error("Respuesta HTTP " + res.status);
      try{
        const data = await res.json();
        if(data && data.ok === false) throw new Error(data.error || "El servidor respondió con un error.");
      }catch(parseErr){ /* respuesta no-JSON pero HTTP OK: se considera guardado */ }
      return id;
    }catch(ex){
      lastErr = ex;
      if(attempt < 4) await sleep(attempt * 1200); // backoff: 1.2s, 2.4s, 3.6s antes de reintentar
    }
  }
  throw lastErr;
}

function scaleField(name, n, labels, required=true){
  let html = `<div class="scale-row">`;
  for(let i=1;i<=n;i++){
    html += `<label class="scale-opt">
      <input type="radio" name="${name}" value="${i}" ${required?'required':''}>
      <span class="lbl"><b>${i}</b>${esc(labels[i-1])}</span>
    </label>`;
  }
  html += `</div>`;
  return html;
}

function textField(name, placeholder="", long=false, required=true){
  return long
    ? `<textarea name="${name}" placeholder="${esc(placeholder)}" ${required?'required':''}></textarea>`
    : `<input type="text" name="${name}" placeholder="${esc(placeholder)}" ${required?'required':''}>`;
}

function selectField(name, options, required=true){
  let html = `<select name="${name}" ${required?'required':''}><option value="" disabled selected>Selecciona…</option>`;
  for(const o of options) html += `<option value="${esc(o)}">${esc(o)}</option>`;
  html += `</select>`;
  return html;
}

function radioSingle(name, options, required=true){
  let html = `<div class="scale-row">`;
  for(const o of options){
    html += `<label class="scale-opt">
      <input type="radio" name="${name}" value="${esc(o)}" ${required?'required':''}>
      <span class="lbl">${esc(o)}</span>
    </label>`;
  }
  html += `</div>`;
  return html;
}

function backBtn(){
  return `<div class="backbar" onclick="renderHome()">&larr; Volver al menú</div>`;
}

// ---------- HOME ----------
async function renderHome(){
  folioTag.textContent = "PEM · FASE 1";
  app.innerHTML = `
    <div class="grid">
      <button class="card-btn" onclick="renderSurvey1()">
        <div class="num">01</div>
        <div><div class="t">Autopercepción de Competencias</div>
        <div class="d">Todo el personal · por puesto</div>
        <span class="tag id">Identificada</span></div>
      </button>
      <button class="card-btn" onclick="renderSurvey2()">
        <div class="num">02</div>
        <div><div class="t">Clima hacia la Capacitación</div>
        <div class="d">Todo el personal</div>
        <span class="tag anon">Anónima</span></div>
      </button>
      <button class="card-btn" onclick="renderSurvey3()">
        <div class="num">03</div>
        <div><div class="t">Gerentes: Brechas Críticas</div>
        <div class="d">Gerentes y supervisores</div>
        <span class="tag id">Identificada</span></div>
      </button>
      <button class="card-btn" onclick="renderSurvey4()">
        <div class="num">04</div>
        <div><div class="t">Permanencia y Aspiración de Carrera</div>
        <div class="d">Todo el personal</div>
        <span class="tag anon">Anónima</span></div>
      </button>
    </div>
    <div style="margin-top:16px;font-size:12px;color:var(--muted);text-align:center;">Los resultados se registran directo en la Hoja de Google del proyecto.</div>
  `;
}

// ---------- SURVEY 1 ----------
function renderSurvey1(){
  folioTag.textContent = "ENCUESTA 01 · AUTOPERCEPCIÓN";
  app.innerHTML = `
    ${backBtn()}
    <div class="panel">
      <h2>01 — Autopercepción de Competencias</h2>
      <div class="meta">Identificada · ~8-10 min · Selecciona tu puesto para ver tus competencias.</div>
      <form id="f1" novalidate onsubmit="return false;">
        <fieldset>
          <legend><span class="q-num">1</span>Nombre completo <span class="req">*</span></legend>
          ${textField("nombre","Nombre y apellidos")}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">2</span>Puesto actual <span class="req">*</span></legend>
          <select name="puesto" id="puestoSel" required onchange="onPuestoChange()">
            <option value="" disabled selected>Selecciona…</option>
            ${Object.entries(PUESTOS).map(([k,v])=>`<option value="${k}">${esc(v.label)}</option>`).join("")}
          </select>
        </fieldset>
        <fieldset>
          <legend><span class="q-num">3</span>Sede <span class="req">*</span></legend>
          ${selectField("sede", SEDES)}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">4</span>Antigüedad en el puesto actual <span class="req">*</span></legend>
          ${radioSingle("antiguedad",["Menos de 6 meses","6-12 meses","1-3 años","3-5 años","Más de 5 años"])}
        </fieldset>
        <div id="corpBlock"></div>
        <div id="compBlock"></div>
        <fieldset id="openF" style="display:none;">
          <legend><span class="q-num" id="openFNum">·</span>¿Qué es lo que más te gustaría aprender o reforzar en los próximos 6 meses? <span class="req">*</span></legend>
          ${textField("aprender","", true)}
        </fieldset>
        <div class="error-msg" id="err1"></div>
        <div class="actions">
          <button class="btn" type="button" id="btn1">Enviar respuesta</button>
        </div>
      </form>
    </div>
  `;
  document.getElementById("btn1").addEventListener("click", submitSurvey1);
}
window.onPuestoChange = function(){
  const key = document.getElementById("puestoSel").value;
  const p = PUESTOS[key];
  const corpBlock = document.getElementById("corpBlock");
  const compBlock = document.getElementById("compBlock");
  const openF = document.getElementById("openF");
  if(!key){ corpBlock.innerHTML=""; compBlock.innerHTML=""; openF.style.display="none"; return; }

  let n = 5;
  // Corporate block — applies to every puesto, including "Otro"
  let corpHtml = `<div class="section-title" style="margin-top:0;">Competencias corporativas (aplican a todos los puestos)</div>`;
  CORPORATE_COMPS.forEach((item,i)=>{
    corpHtml += `<fieldset>
      <legend><span class="q-num">${n++}</span>${esc(item.plain)} <span class="req">*</span></legend>
      ${scaleField("corp_"+i, 4, SCALE4)}
    </fieldset>`;
  });
  corpBlock.innerHTML = corpHtml;

  // Technical block — specific to the selected puesto
  let compHtml = "";
  if(p && p.comps.length){
    compHtml += `<div class="section-title">Preguntas de tu puesto: ${esc(p.label)}</div>`;
    p.comps.forEach((item,i)=>{
      compHtml += `<fieldset>
        <legend><span class="q-num">${n++}</span>${esc(item.plain)} <span class="req">*</span></legend>
        ${scaleField("comp_"+i, 4, SCALE4)}
      </fieldset>`;
    });
  }
  compBlock.innerHTML = compHtml;

  document.getElementById("openFNum").textContent = n;
  openF.style.display = "";
};
async function submitSurvey1(){
  const formEl = document.getElementById("f1");
  const btn = document.getElementById("btn1");
  const err = document.getElementById("err1");
  err.style.display="none";
  if(!checkRequired(formEl, err)) return;
  btn.disabled = true; btn.textContent = "Guardando…";
  try{
    const fd = new FormData(formEl);
    const puestoKey = fd.get("puesto");
    const p = PUESTOS[puestoKey];
    const competencias_corporativas = [];
    CORPORATE_COMPS.forEach((item,i)=>{ competencias_corporativas.push({ nombre:item.tech, pregunta_mostrada:item.plain, nivel: Number(fd.get("corp_"+i)) }); });
    const competencias = [];
    (p.comps||[]).forEach((item,i)=>{ competencias.push({ nombre:item.tech, pregunta_mostrada:item.plain, nivel: Number(fd.get("comp_"+i)) }); });
    const payload = {
      ts: new Date().toISOString(),
      nombre: fd.get("nombre"),
      puesto: p.label,
      sede: fd.get("sede"),
      antiguedad: fd.get("antiguedad"),
      competencias_corporativas,
      competencias,
      aprender: fd.get("aprender")
    };
    const id = await saveEntry("Encuesta1_Autopercepcion", payload);
    showSuccess(id, "Autopercepción de Competencias");
  }catch(ex){
    err.textContent = ex && ex.message && ex.message.indexOf("TIMEOUT")===0
      ? "Se agotó el tiempo de espera al guardar (más de 12 segundos). Verifica tu conexión e inténtalo de nuevo."
      : "No se pudo guardar tu respuesta: " + (ex && ex.message ? ex.message : "error desconocido") + ". Inténtalo de nuevo.";
    err.style.display="block";
    btn.disabled=false; btn.textContent="Enviar respuesta";
  }
}

// ---------- SURVEY 2 ----------
function renderSurvey2(){
  folioTag.textContent = "ENCUESTA 02 · CLIMA";
  app.innerHTML = `
    ${backBtn()}
    <div class="panel">
      <h2>02 — Clima hacia la Capacitación</h2>
      <div class="meta">Anónima · ~4-5 min</div>
      <form id="f2" novalidate onsubmit="return false;">
        <fieldset>
          <legend><span class="q-num">1</span>Sede (solo para agrupar resultados) <span class="req">*</span></legend>
          ${selectField("sede", SEDES)}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">2</span>La capacitación que he recibido en PEM en el último año ha sido útil para mi trabajo <span class="req">*</span></legend>
          ${scaleField("util",5,["Totalmente en desacuerdo","En desacuerdo","Neutral","De acuerdo","Totalmente de acuerdo"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">3</span>La capacitación que he recibido está actualizada y es relevante para las herramientas/equipos que uso hoy <span class="req">*</span></legend>
          ${scaleField("actualizada",5,["Totalmente en desacuerdo","En desacuerdo","Neutral","De acuerdo","Totalmente de acuerdo"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">4</span>Cuando tomo una capacitación, sé claramente si aprendí o no <span class="req">*</span></legend>
          ${scaleField("retro",5,["Totalmente en desacuerdo","En desacuerdo","Neutral","De acuerdo","Totalmente de acuerdo"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">5</span>¿Qué formato prefieres para capacitarte? <span class="req">*</span></legend>
          ${radioSingle("formato",["Presencial en aula","Video corto (10-20 min)","Ficha técnica impresa o PDF","Acompañamiento 1 a 1 con un compañero experto","Una combinación de los anteriores"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">6</span>¿En qué momento del día te resulta más viable capacitarte? <span class="req">*</span></legend>
          ${radioSingle("momento",["Al inicio de mi turno","Durante descansos","Fuera de mi turno (tiempo propio)","No tengo tiempo disponible actualmente"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">7</span>¿Qué tema te gustaría que se capacitara primero en tu área? <span class="req">*</span></legend>
          ${textField("tema","",true)}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">8</span>Comentario libre (opcional)</legend>
          ${textField("comentario","",true,false)}
        </fieldset>
        <div class="error-msg" id="err2"></div>
        <div class="actions"><button class="btn" type="button" id="btn2">Enviar respuesta</button></div>
      </form>
    </div>
  `;
  document.getElementById("btn2").addEventListener("click", async ()=>{
    const formEl = document.getElementById("f2");
    const btn = document.getElementById("btn2"); const err = document.getElementById("err2");
    err.style.display="none";
    if(!checkRequired(formEl, err)) return;
    btn.disabled=true; btn.textContent="Guardando…";
    try{
      const fd = new FormData(formEl);
      const payload = {
        ts:new Date().toISOString(), sede:fd.get("sede"), util:fd.get("util"), actualizada:fd.get("actualizada"),
        retro:fd.get("retro"), formato:fd.get("formato"), momento:fd.get("momento"),
        tema:fd.get("tema"), comentario:fd.get("comentario")||""
      };
      const id = await saveEntry("Encuesta2_Clima", payload); showSuccess(id,"Clima hacia la Capacitación");
    }
    catch(ex){
      err.textContent = ex && ex.message && ex.message.indexOf("TIMEOUT")===0
        ? "Se agotó el tiempo de espera al guardar (más de 12 segundos). Verifica tu conexión e inténtalo de nuevo."
        : "No se pudo guardar tu respuesta: " + (ex && ex.message ? ex.message : "error desconocido") + ". Inténtalo de nuevo.";
      err.style.display="block"; btn.disabled=false; btn.textContent="Enviar respuesta";
    }
  });
}

// ---------- SURVEY 3 ----------
function puestoBlockHtml(n, required){
  return `
    <fieldset>
      <legend>Puesto de tu equipo #${n} ${required?'<span class="req">*</span>':'(opcional)'}</legend>
      <label class="field-label">Nombre del puesto</label>
      ${textField("puesto"+n,"Ej. Técnico de Campo", false, required)}
      <label class="field-label" style="margin-top:12px;">¿Qué le falta hoy a ese equipo para operar sin que tú tengas que supervisarlo constantemente?</label>
      ${textField("falta"+n,"",true, required)}
      <label class="field-label" style="margin-top:12px;">Si tu persona más experimentada de ese puesto faltara mañana sin aviso, ¿qué tan preparado está el resto del equipo para cubrirla?</label>
      ${scaleField("prep"+n, 4, ["Nada preparado","Poco preparado","Preparado","Totalmente preparado"], required)}
    </fieldset>`;
}
function renderSurvey3(){
  folioTag.textContent = "ENCUESTA 03 · GERENTES";
  app.innerHTML = `
    ${backBtn()}
    <div class="panel">
      <h2>03 — Gerentes: Percepción de Brechas Críticas</h2>
      <div class="meta">Identificada · ~10-12 min · Para gerentes y supervisores de área/sede</div>
      <form id="f3" novalidate onsubmit="return false;">
        <fieldset>
          <legend><span class="q-num">1</span>Nombre <span class="req">*</span></legend>
          ${textField("nombre")}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">2</span>Área / sede que supervisas <span class="req">*</span></legend>
          ${textField("area")}
        </fieldset>
        ${puestoBlockHtml(1, true)}
        ${puestoBlockHtml(2, false)}
        ${puestoBlockHtml(3, false)}
        <fieldset>
          <legend><span class="q-num">8</span>De todo tu equipo, ¿qué 3 brechas de competencia son las más urgentes de cerrar en los próximos 6 meses? <span class="req">*</span></legend>
          ${textField("top3","",true)}
        </fieldset>
        <div class="error-msg" id="err3"></div>
        <div class="actions"><button class="btn" type="button" id="btn3">Enviar respuesta</button></div>
      </form>
    </div>
  `;
  document.getElementById("btn3").addEventListener("click", async ()=>{
    const formEl = document.getElementById("f3");
    const btn=document.getElementById("btn3"); const err=document.getElementById("err3");
    err.style.display="none";
    if(!checkRequired(formEl, err)) return;
    btn.disabled=true; btn.textContent="Guardando…";
    try{
      const fd = new FormData(formEl);
      const equipos = [];
      for(let n=1;n<=3;n++){
        const puesto = fd.get("puesto"+n);
        if(puesto){ equipos.push({ puesto, falta: fd.get("falta"+n)||"", preparacion: fd.get("prep"+n)||"" }); }
      }
      const payload = { ts:new Date().toISOString(), nombre:fd.get("nombre"), area:fd.get("area"), equipos, top3:fd.get("top3") };
      const id = await saveEntry("Encuesta3_Gerentes", payload); showSuccess(id,"Gerentes: Percepción de Brechas");
    }
    catch(ex){
      err.textContent = ex && ex.message && ex.message.indexOf("TIMEOUT")===0
        ? "Se agotó el tiempo de espera al guardar (más de 12 segundos). Verifica tu conexión e inténtalo de nuevo."
        : "No se pudo guardar tu respuesta: " + (ex && ex.message ? ex.message : "error desconocido") + ". Inténtalo de nuevo.";
      err.style.display="block"; btn.disabled=false; btn.textContent="Enviar respuesta";
    }
  });
}

// ---------- SURVEY 4 ----------
function renderSurvey4(){
  folioTag.textContent = "ENCUESTA 04 · PERMANENCIA";
  app.innerHTML = `
    ${backBtn()}
    <div class="panel">
      <h2>04 — Permanencia y Aspiración de Carrera</h2>
      <div class="meta">Anónima · ~4 min</div>
      <form id="f4" novalidate onsubmit="return false;">
        <fieldset>
          <legend><span class="q-num">1</span>Sede (solo para agrupar resultados) <span class="req">*</span></legend>
          ${selectField("sede", SEDES)}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">2</span>Familia de puesto (solo para agrupar resultados) <span class="req">*</span></legend>
          ${radioSingle("familia",["Técnico/Operativo","Especialista","Supervisión","Gerencia","Administrativo"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">3</span>Antigüedad en PEM <span class="req">*</span></legend>
          ${radioSingle("antiguedad",["Menos de 1 año","1-3 años","3-5 años","Más de 5 años"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">4</span>¿Qué tan probable es que sigas trabajando en PEM en los próximos 2 años? <span class="req">*</span></legend>
          ${scaleField("probabilidad",5,["Nada probable","Poco probable","Neutral","Probable","Totalmente probable"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">5</span>¿Qué te motivaría más a quedarte y crecer en PEM? <span class="req">*</span></legend>
          ${radioSingle("motivador",["Crecimiento técnico / especializarme más","Oportunidad de supervisión o liderazgo","Mejor compensación","Mejores herramientas o equipo de trabajo","Mayor reconocimiento a mi trabajo","Otro"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">6</span>¿Hacia dónde te gustaría crecer en los próximos 2-3 años? <span class="req">*</span></legend>
          ${radioSingle("crecimiento",["Profundizar como especialista técnico","Pasar a un puesto de supervisión o liderazgo","Mantenerme en mi rol actual","Aún no lo he pensado"])}
        </fieldset>
        <fieldset>
          <legend><span class="q-num">7</span>Comentario libre (opcional)</legend>
          ${textField("comentario","",true,false)}
        </fieldset>
        <div class="error-msg" id="err4"></div>
        <div class="actions"><button class="btn" type="button" id="btn4">Enviar respuesta</button></div>
      </form>
    </div>
  `;
  document.getElementById("btn4").addEventListener("click", async ()=>{
    const formEl = document.getElementById("f4");
    const btn=document.getElementById("btn4"); const err=document.getElementById("err4");
    err.style.display="none";
    if(!checkRequired(formEl, err)) return;
    btn.disabled=true; btn.textContent="Guardando…";
    try{
      const fd = new FormData(formEl);
      const payload = {
        ts:new Date().toISOString(), sede:fd.get("sede"), familia:fd.get("familia"), antiguedad:fd.get("antiguedad"),
        probabilidad:fd.get("probabilidad"), motivador:fd.get("motivador"), crecimiento:fd.get("crecimiento"),
        comentario:fd.get("comentario")||""
      };
      const id = await saveEntry("Encuesta4_Permanencia", payload); showSuccess(id,"Permanencia y Aspiración de Carrera");
    }
    catch(ex){
      err.textContent = ex && ex.message && ex.message.indexOf("TIMEOUT")===0
        ? "Se agotó el tiempo de espera al guardar (más de 12 segundos). Verifica tu conexión e inténtalo de nuevo."
        : "No se pudo guardar tu respuesta: " + (ex && ex.message ? ex.message : "error desconocido") + ". Inténtalo de nuevo.";
      err.style.display="block"; btn.disabled=false; btn.textContent="Enviar respuesta";
    }
