function showSuccess(id, title){
  folioTag.textContent = "RESPUESTA REGISTRADA";
  app.innerHTML = `
    <div class="panel success">
      <div class="check">&#10003;</div>
      <h2>¡Gracias! Tu respuesta fue registrada</h2>
      <div class="meta">${esc(title)}</div>
      <div class="folio2 mono">Folio: ${esc(id)}</div>
      <div class="actions" style="justify-content:center; margin-top:22px;">
        <button class="btn ghost" onclick="renderHome()">Volver al menú</button>
      </div>
    </div>
  `;
}

renderHome();
</script>
</body>
</html>
